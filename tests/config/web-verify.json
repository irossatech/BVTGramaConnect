{
  "distDir": "dist",
  "siteUrl": "https://www.gramaconnect.com",
  "extraPages": [
    "/console/",
    "/404.html"
  ],
  "pageLang": {
    "website": "te",
    "/console/": "en"
  },
  "seoFiles": [
    "robots.txt",
    "sitemap.xml",
    "llms.txt"
  ],
  "budgetsKbGzip": {
    "website": 155,
    "/console/": 160
  },
  "serverPaths": [
    "/api/",
    "/media/"
  ],
  "allowSourceMaps": false,
  "securityHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "X-Frame-Options": "DENY"
  },
  "securityHeadersSource": "BVTGramaConnect_BackEnd deploy/templates/nginx-security.conf, with CSP_SCRIPT_EXTRA empty as in production",
  "perf": {
    "network": {
      "latencyMs": 400,
      "downloadKbps": 400,
      "uploadKbps": 400
    },
    "cpuSlowdown": 4,
    "runs": 3,
    "pages": [
      "/",
      "/faq/",
      "/contact/"
    ],
    "budgets": {
      "lcpMs": 6000,
      "cls": 0.1,
      "tbtMs": 600
    }
  },
  "a11yFailOn": [
    "serious",
    "critical"
  ],
  "fake": {
    "lockoutAfter": 5,
    "appConfig": {
