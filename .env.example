# Copy to .env if you need different values. Real environment variables win over this file.
# Read by `npm run build` (next.config.ts), which builds them into both apps.

# API base URL both apps call. The API is on the same domain in every environment.
GC_API_BASE=/api/v1

# `npm run dev` only: the server /api/ and /media/ are forwarded to. Required for `npm run dev`.
GC_DEV_API=https://dev.gramaconnect.com

# The website's public HTTPS address, no trailing slash. Used for canonical links, the share-preview image and the
# structured data, and the robots.txt, sitemap.xml and llms.txt the build writes. Default https://dev.gramaconnect.com.
GC_SITE_URL=https://dev.gramaconnect.com
