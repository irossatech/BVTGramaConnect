# Copy to .env if you need different values. Real environment variables win over this file.
# Read by `npm run build`, which writes them into dist/config.js and dist/console/config.js.

# API base URL both apps call. The API is on the same domain in every environment.
GC_API_BASE=/api/v1

# Where the website's "Admin Login" button leads.
GC_CONSOLE_URL=/console/
