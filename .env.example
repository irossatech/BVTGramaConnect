# Copy to .env if you need different values. Real environment variables win over this file.
# Read by `npm run build` (next.config.ts), which builds them into both apps.

# API base URL both apps call. The API is on the same domain in every environment.
GC_API_BASE=/api/v1

# `npm run dev` only: the server /api/ and /media/ are forwarded to. Required for `npm run dev`.
# This is the LIVE server: the local console then changes real data, and `npm run dev` prints a red "LIVE DATA"
# warning when it starts. For safe work use a test server or a local backend (http://127.0.0.1:8000).
GC_DEV_API=https://www.gramaconnect.com

# The website's public HTTPS address, no trailing slash. Used for canonical links, the share-preview image and the
# structured data, and the robots.txt, sitemap.xml and llms.txt the build writes. Default https://www.gramaconnect.com (production).
GC_SITE_URL=https://www.gramaconnect.com

# The Android APK the website's "Direct download" link under the store buttons downloads, from this site:
# public/downloads/bvt-grama-connect.apk, copied into the committed dist/ by the build (README, "Android APK download").
# Built in; empty hides the link.
GC_ANDROID_APK_URL=/downloads/bvt-grama-connect.apk

# The website's Google Play and App Store buttons. Empty shows "Coming soon"; set when the app is published, then rebuild.
GC_PLAY_STORE_URL=
GC_APP_STORE_URL=
