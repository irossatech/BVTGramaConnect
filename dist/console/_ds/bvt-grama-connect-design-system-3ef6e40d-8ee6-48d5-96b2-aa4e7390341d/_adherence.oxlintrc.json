{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans Telugu|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans Telugu, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:announce|schemes|news|updates|location)$/]",
        "message": "<Badge> tone must be one of 'announce' | 'schemes' | 'news' | 'updates' | 'location'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<BottomNavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|chevron|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, chevron, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|subtle)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|title|description|cta|image|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HeroCard> doesn't accept that prop. Declared props: category, title, description, cta, image, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:announce|schemes|news|updates|location)$/]",
        "message": "<HeroCard> category must be one of 'announce' | 'schemes' | 'news' | 'updates' | 'location'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|size|icon|style|key|ref|className|style|children)$/]",
        "message": "<IconBadge> doesn't accept that prop. Declared props: category, size, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBadge'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:announce|schemes|news|updates|location)$/]",
        "message": "<IconBadge> category must be one of 'announce' | 'schemes' | 'news' | 'updates' | 'location'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onClick|style|key|ref|className|style|children)$/]",
        "message": "<LocationSelector> doesn't accept that prop. Declared props: value, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|title|description|tinted|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: category, title, description, tinted, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:announce|schemes|news|updates|location)$/]",
        "message": "<ServiceCard> category must be one of 'announce' | 'schemes' | 'news' | 'updates' | 'location'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
